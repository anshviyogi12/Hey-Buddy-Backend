{
    "version": 2,
    "builds": [
        { 
            "src": "index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["prisma/**"]
            }
        }
    ],
    "routes": [
        { "src": "/(.*)", "dest": "/index.js" }
    ],
    "env": {
        "DATABASE_URL": "@database_url",
        "PORT": "8000"
    }
}
