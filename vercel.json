{
    "version": 2,
    "builds": [
        { 
            "src": "index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["prisma/**"]
            }
        }
    ],
    "routes": [
        {
            "src": "/socket.io/(.*)",
            "dest": "/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "/index.js"
        }
    ]
}
